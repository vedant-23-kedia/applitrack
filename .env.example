# Copy to .env and fill in. .env is gitignored - never commit the real one.

# REQUIRED. Encrypts every user's Google token at rest.
# Generate with:  python -m applitrack.web.cli keygen
# Losing this means every user must reconnect.
APPLITRACK_SECRET_KEY=

# Where Google sends people back after sign-in. Must match the redirect URI
# registered on your OAuth client exactly.
APPLITRACK_REDIRECT_URI=http://localhost:5000/oauth2callback

# Local development over plain HTTP. Set both to 0 / remove in production.
APPLITRACK_HTTPS=0
OAUTHLIB_INSECURE_TRANSPORT=1

# How often to re-check every mailbox when push notifications are not set up.
APPLITRACK_POLL_MINUTES=15

# --- optional: email notifications ---------------------------------------
# Gmail needs an App Password, not your account password.
# APPLITRACK_SMTP_HOST=smtp.gmail.com
# APPLITRACK_SMTP_PORT=587
# APPLITRACK_SMTP_USER=you@gmail.com
# APPLITRACK_SMTP_PASSWORD=
# APPLITRACK_FROM_NAME=AppliTrack

# --- optional: real-time updates via Gmail push --------------------------
# APPLITRACK_PUBSUB_TOPIC=projects/YOUR-PROJECT/topics/applitrack-gmail
# APPLITRACK_PUSH_TOKEN=some-long-random-string
